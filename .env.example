# Use a long random value and configure the same token in NapCatQQ.
ONEBOT_ACCESS_TOKEN=replace-with-a-random-token-at-least-16-characters
ALLOWED_GROUP_IDS=123456789

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
DATABASE_PATH=data/chat_history.db
LOG_LEVEL=INFO
PROFILE_MESSAGE_LIMIT=50
PROFILE_CHARACTER_BUDGET=6000
PROFILE_TARGET_LIMIT=5

# NoneBot reverse WebSocket listener. Keep this on loopback.
BOT_HOST=127.0.0.1
BOT_PORT=8080
